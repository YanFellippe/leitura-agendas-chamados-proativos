# Microsoft Graph (Azure AD)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
TENANT_ID=your-tenant-id

# InvGate ITSM
# Ambiente ativo: "staging" ou "production"
INVGATE_ENV=staging

INVGATE_USERNAME=your-invgate-username
INVGATE_API_KEY=your-invgate-api-key

# URLs de produção (staging já está hardcoded no serviço)
INVGATE_PROD_URL=https://sua-empresa.sd.cloud.invgate.net

# IDs do InvGate (obter via API ou painel)
INVGATE_CUSTOMER_ID=0
INVGATE_CREATOR_ID=0
INVGATE_CATEGORY_ID=0   # ID da categoria "Ronda diária"
INVGATE_PRIORITY_ID=2   # 1=Low 2=Medium 3=High 4=Urgent 5=Critical
INVGATE_TYPE_ID=2       # 1=Incident 2=Service Request 3=Question...
